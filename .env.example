# Copy the values you need into .env.local; never put real keys in this file.
# All API keys below are server-side only. Do not prefix them with NEXT_PUBLIC_.
# Luna reader answers and the cumulative budget are active. Other provider
# adapters are introduced by their implementation tickets.

# Google AI Studio: embeddings for library retrieval.
# https://ai.google.dev/gemini-api/docs/models/gemini-embedding-2
GOOGLE_API_KEY=
GOOGLE_EMBEDDING_MODEL=gemini-embedding-2
GOOGLE_EMBEDDING_DIMENSIONS=768

# TypeSafe directly: Jev chooses categories from the library's taxonomy.
# https://docs.typesafe.ai/
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# OpenAI directly: Luna generates answers with citations to saved sources.
# https://developers.openai.com/api/docs/models/gpt-6-luna
OPENAI_API_KEY=
OPENAI_ANSWER_MODEL=gpt-6-luna

# Initial cumulative USD budget across paid Sakamoto processing, persisted in Neon.
# No automatic reset. Intentionally increasing this value raises the durable cap;
# older replicas cannot lower it again. Never reset the ledger to permit retries.
# Price snapshot: 2026-10-16-standard-v1 in lib/paid-work.ts (unknown versions pause).
# Controls this deployment only, not other use of provider keys or Grok subscriptions.
SAKAMOTO_BUDGET_USD=10
# Operator recovery for uncertain attempts: npm run budget:reconcile -- /absolute/receipt.json
# Required receipt fields/verification contract are documented in scripts/reconcile-paid.ts.
# Never infer zero charge from an interrupted response or missing dashboard entry.
# A credible provider bound violation halts dispatch until its assumptions are repaired;
# increasing the spending cap alone does not clear that safety pause.

# Neon is the only server database, including the planned pgvector index.
# `npm run db:migrate` currently creates the existing tables, not vector indexes.
DATABASE_URL=

# Clerk. Accounts are optional; signed in, notes and highlights sync across devices.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# The public origin, for canonical and social card URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Planned daily processing cron authentication on Vercel (not wired yet).
# Use a unique random secret of at least 16 characters when enabling the cron.
CRON_SECRET=

# Grok-assisted imports use the public Sakamoto MCP endpoint and a personal
# token created under Connect an agent. No Grok/X API key belongs in this file.
# The daily bookmark-fetch routine runs in Grok; Sakamoto processes its imports.

# Legacy providers used by existing features until their adapters are migrated.
# These are not required credentials for the planned provider split above.
TOGETHER_API_KEY=

# Exa web search, for Fact-check and questions asked with Web on. Optional: without it answers stay inside the text.
EXA_API_KEY=
# Required maximum charge per instant search when Exa is enabled. An absent
# ceiling pauses the web lookup branch; saved-text answers still work with Web off.
SAKAMOTO_EXA_MAX_USD=

# Optional legacy LlamaParse for "Read it more carefully" on hard PDFs.
# Its current route also requires the reader's Together key; this is not the
# planned unattended PDF import path.
LLAMA_CLOUD_API_KEY=

# Optional stricter unattended PDF worker timeout (1–8000 ms; hard cap 8000).
PDF_EXTRACTION_TIMEOUT_MS=8000
